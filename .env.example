# ---- 模型 ----
# OpenAI 兼容接口（/v1/chat/completions）填 openai；Anthropic 原生（/v1/messages）填 anthropic
MODEL_PROTOCOL=openai
# 只填到 /v1，不要带 /chat/completions
MODEL_BASE_URL=https://example.com/v1
MODEL_API_KEY=
MODEL_NAME=

# ---- Bark ----
# Bark App 首页链接 https://api.day.app/XXXX/ 里的 XXXX
BARK_KEY=
BARK_SERVER=https://api.day.app
BARK_SOUND=minuet

# ---- 心潮 MCP ----
XINCHAO_MCP_URL=https://xinchao.cc-home.top/mcp
# 心潮的 bpt_ 开头的令牌
XINCHAO_TOKEN=

# ---- 节奏 ----
TZ_LOCAL=Asia/Shanghai
# 大约多久醒一次（分钟），实际会在 ± 抖动范围里随机
WAKE_EVERY_MINUTES=90
WAKE_JITTER_MINUTES=30
# 两条主动消息之间至少隔多久（分钟）
MIN_GAP_MINUTES=150
# 一天最多主动发几条
MAX_PER_DAY=5
# 安静时段（本地小时，含开始不含结束），这段时间不叫醒模型
QUIET_START_HOUR=3
QUIET_END_HOUR=10
